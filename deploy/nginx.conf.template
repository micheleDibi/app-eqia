# IP e dominio sono valorizzati dal contratto staging.json tramite Compose.
log_format essenziale '$remote_addr $request_method $uri $status';
server {
    listen 8080;
    server_name ${EQIA_DOMAIN};
    access_log /dev/stdout essenziale;
    error_log /dev/stderr warn;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 10m;
    set_real_ip_from ${EQIA_PROXY_IP};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location = /healthz { access_log off; return 200 'ok'; }
    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api http://api:8000;
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
        proxy_set_header Host ${EQIA_DOMAIN};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location /assets/ { expires 7d; try_files $uri =404; }
    location / { expires -1; try_files $uri $uri/ /index.html; }
}
